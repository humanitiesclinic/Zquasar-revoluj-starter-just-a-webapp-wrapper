name: Build & Deploy PWA

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  create-release:
    runs-on: ubuntu-latest
    steps:
      - name: Create GitHub Release
        run: gh release create ${{ github.ref_name }} --title "${{ github.ref_name }}" --notes "Automated build for ${{ github.ref_name }}"
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GH_REPO: ${{ github.repository }}

  build-pwa:
    needs: create-release
    runs-on: ubuntu-latest
    continue-on-error: true
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-node@v3
        with:
          node-version: '22'
      - run: npm install
      - run: npx quasar build -m pwa
      - name: Debug dist paths
        run: ls -R dist/
      - name: Package PWA for release
        run: tar -czf pwa-dist.tar.gz -C dist pwa
      - name: Upload PWA to release
        run: gh release upload ${{ github.ref_name }} pwa-dist.tar.gz
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GH_REPO: ${{ github.repository }}
      - name: Deploy PWA to Surge
        run: |
          npm install -g surge@0.27.3
          export SURGE_TOKEN=935aec63550df73f541822b03ea28d26
          surge dist/pwa --domain=${{ github.event.repository.name }}.huclin.surge.sh
          surge dist/pwa --domain=${{ github.event.repository.name }}.surge.sh
      - name: Commit PWA build
        run: |
          git config user.name "GitHub Actions"
          git config user.email "actions@github.com"
          git add .
          git commit -m "Build: PWA [tag: ${{ github.ref_name }}]" -m "Co-Authored-By: Warp <agent@warp.dev>" || true
          git pull --rebase origin main
          git push origin HEAD:main
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  build-pwa-dev:
    runs-on: ubuntu-latest
    continue-on-error: true
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-node@v3
        with:
          node-version: '22'
      - run: npm install
      - run: npx quasar build -m pwa
      - name: Deploy PWA Dev to Surge
        run: |
          npm install -g surge@0.24.6
          export SURGE_TOKEN=935aec63550df73f541822b03ea28d26
          surge dist/pwa --domain=${{ github.event.repository.name }}-dev.huclin.surge.sh
          surge dist/pwa --domain=${{ github.event.repository.name }}-dev.surge.sh
